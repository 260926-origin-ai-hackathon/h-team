# Mapbox public token (pk.*) — used at runtime by @rnmapbox/maps
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxx
# Mapbox secret download token (sk.* with DOWNLOADS:READ) — used only when building native code
MAPBOX_DOWNLOAD_TOKEN=sk.xxx
# Convex deployment URL — printed by `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=https://xxx.convex.cloud
